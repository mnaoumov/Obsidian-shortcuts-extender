{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2018"],
    "strict": true,
    "noImplicitAny": true,
    "allowJs": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,
    "importHelpers": true,
    "isolatedModules": true
  },
  "include": ["main.ts"]
}