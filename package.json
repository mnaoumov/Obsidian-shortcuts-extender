{
  "name": "shortcuts-extender",
  "version": "3.0.0",
  "description": "Adds editor commands for markdown formatting and inserting special symbols without switching keyboard layout.",
  "main": "main.js",
  "scripts": {
    "dev": "rollup --config rollup.config.js -w",
    "build": "rollup --config rollup.config.js",
    "check": "tsc --noEmit",
    "release": "standard-version"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "markdown",
    "shortcuts"
  ],
  "author": "kitchenrunner",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^20.19.9",
    "obsidian": "latest",
    "rollup": "^4.46.2",
    "standard-version": "^9.5.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryjjin/Obsidian-shortcuts-extender.git"
  },
  "bugs": {
    "url": "https://github.com/ryjjin/Obsidian-shortcuts-extender/issues"
  },
  "homepage": "https://github.com/ryjjin/Obsidian-shortcuts-extender#readme"
}
